---
import type { CollectionEntry } from 'astro:content';
import { casePreviews } from '../data/casePreviews';
interface Props { project: CollectionEntry<'projects'>; featured?: boolean; }
const { project, featured = false } = Astro.props;
const preview = casePreviews[project.id];
---
<a class:list={['project-card', { featured }]} href={`/projects/${project.id}/`}>
  {preview ? <div class="project-preview" aria-hidden="true">
    <img src={preview.src} alt="" width="860" height="440" loading="lazy" />
    <div class="preview-caption">{preview.caption}</div>
  </div> : <div class="project-preview project-preview-generic" aria-hidden="true"><span class="eyebrow">{project.data.category}</span><strong>{project.data.title}</strong><span>{project.data.tags.slice(0,3).join(' / ')}</span></div>}
  <div class="project-card-copy"><div class="meta-line"><span>{project.data.category}</span><span>{project.data.scope ?? project.data.role}</span></div><h3>{project.data.title}</h3><p>{project.data.description}</p>{project.data.highlights.length > 0 && <ul class="project-card-points">{project.data.highlights.slice(0,3).map(point => <li>{point}</li>)}</ul>}<div class="tags">{project.data.tags.map(tag => <span>{tag}</span>)}</div><span class="text-link">화면과 구현 살펴보기 <span>↗</span></span></div>
</a>
