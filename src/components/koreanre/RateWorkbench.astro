<style is:global>
  .quote-lab{--q-ink:#102b49;--q-line:#cbd1d3;--q-amber:#f1ae3e;scroll-margin-top:100px;margin:14px 0 clamp(36px,5vw,66px);color:var(--q-ink)}
  .quote-heading{margin:0 0 20px}.quote-heading .quote-kicker{margin:0 0 8px;font-size:.76rem;font-weight:700;color:#4b6276;letter-spacing:.045em}.quote-heading h2{margin:0;font-weight:740;font-size:clamp(1.72rem,3.2vw,2.65rem);line-height:1.16;letter-spacing:-.052em}.quote-heading h2 br{display:none}.quote-heading h2 br::after{content:" "}
  .quote-heading>p:last-child{margin:13px 0 0;max-width:70ch;color:#43515c;line-height:1.65;font-size:.97rem}
