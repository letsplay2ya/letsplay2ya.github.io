  .quote-bar,.quote-subhead,.quote-result{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
  .quote-bar{background:var(--q-ink);color:#fff;padding:13px clamp(14px,2.2vw,30px);align-items:center}.quote-bar strong{font-weight:710;letter-spacing:-.025em}.quote-bar span{color:#d3e1e8;font-size:.78rem}
  .quote-controls{display:flex;gap:12px 26px;align-items:end;padding:15px clamp(14px,2.2vw,30px);border-bottom:1px solid var(--q-line);background:#edf1f2}
  .quote-controls fieldset{border:0;margin:0;padding:0;min-width:0}.quote-controls legend,.quote-select{color:#42576b;font-size:.76rem;font-weight:660}.quote-controls legend{padding:0;margin:0 0 4px}
  .quote-choices{display:flex;gap:0}.quote-choices label{display:block;position:relative;cursor:pointer}.quote-choices input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
  .quote-choices span,.quote-select select{display:block;white-space:nowrap;font:650 .86rem/1.35 Pretendard,system-ui,sans-serif;letter-spacing:-.02em;background:white;color:var(--q-ink);border:1px solid #a7b4bd;padding:9px 12px}
  .quote-choices label+label span{border-left:0}.quote-choices label:first-child span{border-radius:3px 0 0 3px}.quote-choices label:last-child span{border-radius:0 3px 3px 0}
  .quote-choices input:checked+span{background:var(--q-ink);color:white;border-color:var(--q-ink)}.quote-choices input:focus-visible+span{outline:3px solid #ab6415;outline-offset:2px;position:relative}
  .quote-select{display:block}.quote-select select{margin-top:4px;max-width:100%;border-radius:3px;min-height:38px}
  .quote-panes{display:grid;grid-template-columns:1.12fr 1fr}.quote-panes section{min-width:0;padding:clamp(15px,2.2vw,30px)}.quote-view{background:#fff}.quote-packet{background:#faf8f1;border-left:1px solid var(--q-line)}
  .quote-subhead{margin:0 0 12px}.quote-subhead h3{margin:0;font-size:clamp(1.02rem,1.8vw,1.33rem);font-weight:700}.quote-subhead>span{white-space:nowrap;font-weight:750;font-variant-numeric:tabular-nums}.quote-packet .quote-subhead>span{box-shadow:inset 0 -.42em #f9d69b}
  .quote-table{width:100%;border-collapse:collapse;text-align:left;font-variant-numeric:tabular-nums;font-size:.87rem;line-height:1.4}.quote-table caption{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.quote-table thead{border-block:1px solid var(--q-line);color:#506273;background:#f4f6f5;font-size:.75rem}.quote-table th,.quote-table td{padding:9px 7px}.quote-table tbody tr{border-bottom:1px solid #e1e5e3}.quote-table tbody th{font-weight:600}.quote-table tr>:last-child{text-align:right}.quote-table .quote-empty{text-align:left;font-weight:550;color:#59646b}
  .quote-caption{margin:11px 0 0;color:#546570;font-size:.79rem;line-height:1.5}.quote-groups{margin:0;padding:0;list-style:none}.quote-groups li{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 0;border-top:1px solid #d7d7ce;font-size:.85rem}.quote-groups b{font-size:.78rem;font-weight:600;color:#625640}
  .quote-order{display:flex;align-items:center;gap:6px;font-size:.77rem;margin-top:12px;cursor:pointer;line-height:1.4}.quote-order input{accent-color:var(--q-ink);margin:0}.quote-order>span{color:#5c655f;font-size:.74rem;white-space:nowrap}
  .quote-save{border:1px solid #d09a45;background:#ffe0a6;color:#34240d;font-weight:720;font-size:.88rem;padding:8px 13px;border-radius:3px;margin:12px 0 0;min-height:40px}.quote-save span{margin-left:12px}.quote-save:hover:enabled{background:#ffd285}.quote-save:disabled{cursor:not-allowed;opacity:.55}
  .quote-result{background:#e8edf0;padding:11px clamp(14px,2.2vw,30px);align-items:start;justify-content:start;font-size:.83rem;line-height:1.5}.quote-result strong{white-space:nowrap}.quote-result span{color:#435261}.quote-evidence{font-size:.87rem;color:#465767;margin:11px 0 0}.quote-evidence summary{cursor:pointer;font-weight:630;color:#28455e;text-decoration:underline;text-underline-offset:3px;width:fit-content}.quote-evidence p{max-width:84ch;margin:10px 0 0;line-height:1.7}.quote-evidence code{font-size:.94em}.quote-links{display:flex;gap:7px 20px;flex-wrap:wrap;margin-top:10px}.quote-links a{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:660px){.quote-heading h2 br{display:block}.quote-panes{grid-template-columns:1fr}.quote-packet{border-left:0;border-top:1px solid var(--q-line)}.quote-controls{flex-wrap:wrap;gap:9px 16px}.quote-result{display:grid;gap:2px}.quote-bar{flex-wrap:wrap;gap:2px 10px}.quote-result strong{white-space:normal}}
</style>
