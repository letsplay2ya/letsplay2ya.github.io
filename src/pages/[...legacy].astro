---
import routes from '../data/legacy-routes.json';
export function getStaticPaths() {
  return routes.map(route => ({
    params: { legacy: decodeURI(route.from).replace(/^\/+|\/+$/g, '') },
    props: { target: route.to },
  }));
}
interface Props { target: string; }
const { target } = Astro.props;
---
<!doctype html>
<html lang="ko"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>글 주소가 변경되었습니다 · 전성민</title><meta name="robots" content="noindex" /><meta http-equiv="refresh" content={`0;url=${target}`} /></head><body><p>글 주소가 변경되었습니다. <a id="destination" href={target}>이전한 글 읽기</a></p><script is:inline>
const destination = document.querySelector('#destination');
if (destination) location.replace(destination.getAttribute('href') + location.search + location.hash);
</script></body></html>
