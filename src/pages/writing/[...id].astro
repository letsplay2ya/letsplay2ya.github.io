---
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CsvQualityDemo from '../../components/experiments/CsvQualityDemo';
import ClauseEligibilityDemo from '../../components/experiments/ClauseEligibilityDemo';
import ScrollSyncDemo from '../../components/experiments/ScrollSyncDemo';
import VueSearchRace from '../../components/experiments/VueSearchRace.vue';
export async function getStaticPaths() {
  return (await getCollection('posts', p => !p.data.draft)).map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const project = post.data.project ? await getEntry('projects', post.data.project) : undefined;
const related = (await getCollection('posts', p => !p.data.draft && !p.data.archive && p.id !== post.id && p.data.tags.some(tag => post.data.tags.includes(tag)))).slice(0,3);
---
<SiteLayout title={post.data.title} description={post.data.description}>
  <article class="container article-shell"><header class="article-heading"><a class="back-link" href="/writing/">← 모든 기술 글</a><div class="meta-line"><span>{post.data.category}</span><span>작성</span><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10).replaceAll('-','.')}</time>{post.data.updated && <><span>수정</span><time datetime={post.data.updated.toISOString()}>{post.data.updated.toISOString().slice(0,10).replaceAll('-','.')}</time></>}</div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></header>{post.data.archive && <p class="archive-note">보관함의 기록입니다. 아래 본문에서 통합한 안내로 연결됩니다. <a href="/writing/archive/">보관함 보기 →</a></p>}{post.id === 'legacy-oracle-ch3' && <CsvQualityDemo client:load />}{post.id === 'notes-clause-eligibility' && <ClauseEligibilityDemo client:load />}{post.id === 'notes-keyed-scroll-sync' && <ScrollSyncDemo client:load />}{post.id === 'notes-vue-search-cleanup' && <VueSearchRace client:load />}<div class="article-columns"><div><div class="prose"><Content /></div>{project && !project.data.draft && <a class="related-project" href={`/projects/${project.id}/`}><span>이 글의 프로젝트</span><b>{project.data.title} ↗</b></a>}{post.data.origin === 'hexo' && <p class="article-origin">{post.data.updated ? '기존 Hexo 글을 다시 검토해 설명과 예제를 수정했습니다. 최초 작성일과 주소는 유지했습니다.' : '기존 Hexo 블로그에서 옮긴 학습 기록입니다. 당시의 환경을 기준으로 작성했습니다.'}</p>}<div class="article-end"><a href="/writing/">← 기술 글 목록</a><a href="#main">위로 ↑</a></div></div><aside class="article-toc"><span class="eyebrow">ON THIS PAGE</span>{headings.filter(h => h.depth <= 3).map(h => <a class:list={[{ nested: h.depth === 3 }]} href={`#${h.slug}`}>{h.text}</a>)}</aside></div>{related.length > 0 && <section class="related-reading"><h2>이어서 읽기</h2>{related.map(item => <a href={`/writing/${item.id}/`}>{item.data.title}<span>↗</span></a>)}</section>}</article>
</SiteLayout>
