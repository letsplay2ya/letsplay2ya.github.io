---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import DocuonProjection from '../../components/docuon/DocuonProjection.vue';
import DocuonTransfer from '../../components/DocuonTransfer.vue';
import ProjectWorkspace from '../../components/ProjectWorkspace.vue';
import ReferenceReview from '../../components/koreanre/ReferenceReview';
import DocAgentReplay from '../../components/experiments/DocAgentReplay';

export async function getStaticPaths() {
  return (await getCollection('projects', project => !project.data.draft))
    .map(project => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content, headings } = await render(project);
const notes = await getCollection('posts', post => !post.data.draft && post.data.project === project.id);
---
<SiteLayout title={project.data.title} description={project.data.description} wide>
  <article class="container article-shell">
    <header class="article-heading project-detail-heading">
      <a class="back-link" href="/projects/">← 프로젝트 목록</a>
      <div class="meta-line"><span>{project.data.category}</span><span>PROJECT CASE STUDY</span></div>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
    </header>
    <div class="project-facts">
      <div><small>{project.data.scope ? '구현 범위' : '역할'}</small><span>{project.data.scope ?? project.data.role}</span></div>
      <div><small>FOCUS</small><span>{project.data.category}</span></div>
      <div><small>TECHNOLOGIES</small><div class="tags">{project.data.tags.map(tag => <span>{tag}</span>)}</div></div>
    </div>

    {project.id === 'doc-check-agent' && <DocAgentReplay client:load />}
    <div class="article-columns">
      <div class="prose project-narrative"><Content /></div>
      <aside class="article-toc" aria-label="본문 목차">
        <span class="eyebrow">IN THIS PROJECT</span>
        {headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        {project.id === 'koreanre-ai-assistant' && <a href="#workspace-title">참고 계약 비교 화면</a>}
        {project.id === 'docuon' && <><a href="#transfer-rows">이관 대상 조회 화면</a><a href="#transfer-demo">신청·심사 화면</a></>}
      </aside>
    </div>

    {project.id === 'koreanre-ai-assistant' && (
      <section class="workspace-section" aria-labelledby="workspace-title">
        <h2 id="workspace-title">참고 계약에서 필요한 항목만 가져오기</h2>
        <p>‘이 계약과 비교’를 누르고 상품·기간·지역 중 가져올 항목을 골라 보세요. 상품을 복사하면 코드와 상품명이 함께 바뀝니다. 계약 A와 B를 오가면 각 계약에 남긴 입력을 확인할 수 있습니다.</p>
        <ReferenceReview client:load />
        <p class="workspace-caption">원본 React의 요약·키워드 강조·복사 버튼을 사용했습니다. 계약 데이터는 가상이며, 변경 미리보기와 되돌리기는 예제에서 추가했습니다. <a href="/writing/notes-reference-copy/">원본의 필드별 적용 과정 읽기 →</a></p>
        <details class="workspace-overview">
          <summary>네 개 탭 구조 보기</summary>
          <p class="workspace-caption">가상 계약으로 기본정보·상세정보·약관·요율 사이를 이동하는 Vue 재구성 화면입니다.</p>
          <ProjectWorkspace client:load />
        </details>
      </section>
    )}
    {project.id === 'docuon' && <><DocuonProjection client:load /><DocuonTransfer client:load /></>}
    {notes.length > 0 && (
      <section class="related-reading">
        <h2>프로젝트에서 이어진 기술 글</h2>
        {notes.map(note => <a href={`/writing/${note.id}/`}>{note.data.title}<span>↗</span></a>)}
      </section>
    )}
    <nav class="article-end" aria-label="다른 글 찾아보기"><a href="/projects/">← 모든 프로젝트</a><a href="/writing/">기술 글 보기 ↗</a></nav>
  </article>
</SiteLayout>

<style>
  .project-narrative { min-width: 0; }
</style>
