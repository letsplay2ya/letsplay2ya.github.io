---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import DocuonProjection from '../../components/docuon/DocuonProjection.vue';
import DocumentIssuance from '../../components/docuon/DocumentIssuance.astro';
import DocuonTransfer from '../../components/DocuonTransfer.vue';
import ProjectWorkspace from '../../components/ProjectWorkspace.vue';
import ReferenceReview from '../../components/koreanre/ReferenceReview';
import DocAgentReplay from '../../components/experiments/DocAgentReplay';

export async function getStaticPaths() {
  return (await getCollection('projects', project => !project.data.draft))
    .map(project => ({ params: { id: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content, headings } = await render(project);
const notes = await getCollection('posts', post => !post.data.draft && post.data.project === project.id);
const isInsurance = project.id === 'koreanre-ai-assistant';
const isDocuon = project.id === 'docuon';
---
<SiteLayout title={project.data.title} description={project.data.description} wide>
  <article class="container article-shell case-detail">
    <header class="article-heading case-head">
      <a class="back-link" href="/projects/">← 프로젝트 목록</a>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
      <div class="case-facts"><span>{project.data.role}</span><span>{project.data.tags.slice(0,4).join(' · ')}</span><a href="#implementation">구현 과정 ↓</a></div>
    </header>
    {isInsurance && <section class="workspace-section case-proof" aria-labelledby="workspace-title">
      <h2 id="workspace-title">참고 계약에서 상품만 가져오기</h2>
      <ReferenceReview client:load />
      <p class="workspace-caption">원본 React의 요약·강조·복사 버튼을 활용한 가상 계약 화면입니다. 적용 전 미리보기와 되돌리기는 시연용 기능입니다. <a href="/writing/notes-reference-copy/">필드별 적용 규칙 →</a></p>
    </section>}
    {isDocuon && <DocumentIssuance />}
    {project.id === 'doc-check-agent' && <DocAgentReplay client:load />}
    <div id="implementation" class="article-columns">
      <div class="prose project-narrative"><Content /></div>
      <aside class="article-toc" aria-label="본문 목차">
        <span class="eyebrow">이 프로젝트에서</span>
        {headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}
        {isInsurance && <a href="#workspace-title">참고 계약 비교 화면</a>}
        {isDocuon && <><a href="#transfer-rows">이관 대상 조회 화면</a><a href="#transfer-demo">이관 신청·심사 화면</a></>}
      </aside>
    </div>
    {isInsurance && <details class="workspace-overview">
      <summary>네 개 탭 구조 보기</summary>
      <p class="workspace-caption">가상 계약으로 기본정보·상세정보·약관·요율 사이를 이동하는 Vue 재구성 화면입니다.</p>
      <ProjectWorkspace client:load />
    </details>}
    {isDocuon && <><DocuonProjection client:load /><DocuonTransfer client:load /></>}
    {notes.length > 0 && <section class="related-reading">
      <h2>관련 기술 글</h2>
      {notes.map(note => <a href={`/writing/${note.id}/`}>{note.data.title}<span>↗</span></a>)}
    </section>}
    <nav class="article-end" aria-label="다른 글 찾아보기"><a href="/projects/">← 모든 프로젝트</a><a href="/about/">경력 요약 →</a></nav>
  </article>
</SiteLayout>
<style>
  .case-detail { padding-top: clamp(20px,3vw,38px); }
  .case-head { max-width: none; margin-bottom: 22px; padding-bottom: 17px; }
  .case-head h1 { margin: 12px 0 9px; max-width: 950px; font-size: clamp(27px,3.5vw,46px); }
  .case-head p { max-width: 775px; margin: 0; }
  .case-facts { display: flex; align-items: center; flex-wrap: wrap; gap: 5px 15px; margin-top: 13px; font-size: 12px; color: var(--muted); }
  .case-facts span + span { border-left: 1px solid var(--line); padding-left: 15px; }
  .case-facts a, .workspace-caption a { text-decoration: underline; text-underline-offset: 3px; }
  .case-proof { margin: 0 0 22px; }
  .case-proof > h2 { margin: 0 0 12px; font-size: clamp(18px,2vw,24px); }
  .case-proof .workspace-caption { margin-block: 6px; font-size: 12px; }
  .project-narrative { min-width: 0; }
  .workspace-overview { margin-block: 30px; }
</style>
